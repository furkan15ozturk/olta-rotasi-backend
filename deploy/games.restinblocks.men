server {
    listen 80;
    listen [::]:80;
    server_name games.restinblocks.men;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name games.restinblocks.men;
    ssl_certificate /etc/letsencrypt/live/games.restinblocks.men/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/games.restinblocks.men/privkey.pem;
    client_max_body_size 64k;
    location / {
        proxy_pass http://127.0.0.1:7030;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
}
